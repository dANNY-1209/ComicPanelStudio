# ---- 必填 ----
# Discord OAuth（Discord Developer Portal → OAuth2）。Redirect 要加：<CPS_PUBLIC_URL>/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# 對外網址（不要結尾斜線）
CPS_PUBLIC_URL=https://comic.example.com
# 站長的 Discord ID：永遠有權限，也看得到所有專案
CPS_OWNER_DISCORD_ID=
# 簽登入 cookie 用，隨便一長串亂碼；沒設的話每次重啟大家都要重新登入
CPS_SESSION_SECRET=

# ---- 選填 ----
# 白名單資料夾（預設 /data/auth）：whitelist.json / admins.json / users.json，格式見 README
# CPS_AUTH_DIR=/data/auth
# 「沒有權限」頁面的申請連結
# CPS_SANCTUM_URL=https://sanctum.example.com
# 本機測試用：設了就跳過 Discord，直接以這個 ID 登入（正式環境絕對不要設）
# CPS_DEV_BYPASS=
